<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Only used to download artwork that an app publishes for what it is playing (HTTPS only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to show the Wi-Fi icon in the top bar as connected or not. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets the hero read Android TV's Watch Next and apps' home-screen rows. Granted automatically. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <!-- Lets the launcher see installed TV apps without the broad QUERY_ALL_PACKAGES permission. -->
    <queries>
        <provider android:authorities="android.media.tv" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="TV Home"
        android:theme="@style/AppTheme">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The side panel for the remote's Settings / notifications button. The system sends this
             action when the button is pressed. -->
        <activity
            android:name=".PanelActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.TOGGLE_NOTIFICATION_HANDLER_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Empty service: the thing "notification access" is granted to so the hero can see
             what is playing. It never reads notifications. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="TV Home"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Catches the remote's Settings button and opens the quick settings panel. -->
        <service
            android:name=".KeyService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>
    </application>
</manifest>
